<ContentDialog
    x:Class="QuotingEngine.UI.CameraCaptureDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuotingEngine.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:CommunityToolkit.WinUI.Helpers"
    mc:Ignorable="d"
    Title="Capture ID / Item"
    PrimaryButtonText="Capture"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Closing="ContentDialog_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Image x:Name="CameraPreview" Stretch="UniformToFill" Width="400" Height="300" />
        <TextBlock x:Name="ErrorText" Foreground="Red" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed" />
    </Grid>
</ContentDialog>
