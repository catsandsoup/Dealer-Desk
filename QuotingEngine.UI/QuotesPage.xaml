<Page
    x:Class="QuotingEngine.UI.QuotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:QuotingEngine.Core.Models"
    xmlns:converters="using:QuotingEngine.UI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NumericStringConverter x:Key="NumericConverter"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- CommandBar -->
        <Grid Grid.Row="0" Background="Transparent">
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center">
                <AppBarButton x:Name="NewOrderBtn" AutomationProperties.AutomationId="NewOrderBtn" Icon="Add" Label="New Order" Command="{x:Bind ViewModel.NewOrderCommand}"/>
                <AppBarButton x:Name="UndoBtn" AutomationProperties.AutomationId="UndoBtn" Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}"/>
                <AppBarButton x:Name="DeleteDraftBtn" AutomationProperties.AutomationId="DeleteDraftBtn" Icon="Delete" Label="Delete Draft" Command="{x:Bind ViewModel.DeleteDraftCommand}"/>
                <AppBarButton x:Name="TearOutTickerBtn" Icon="NewWindow" Label="Tear Out Ticker" Click="TearOutTickerBtn_Click"/>

                <AppBarSeparator/>
                <AppBarElementContainer VerticalAlignment="Center" Margin="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Spot:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="LiveSpotText" Text="{x:Bind ViewModel.CurrentSpotPriceText, Mode=OneWay}" FontWeight="SemiBold" Foreground="Green" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontWeight="Bold" Foreground="LimeGreen" VerticalAlignment="Center"/>
                        <TextBlock Text="(F2 to Freeze)" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                </AppBarElementContainer>
            </CommandBar>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Customer Card -->
            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="CustomerNameBox" AutomationProperties.AutomationId="CustomerNameBox" Grid.Column="0" Header="Customer Name" PlaceholderText="Legal Name" Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnCustomerNameKeyDown"/>
                    <TextBox x:Name="IdDocBox" Grid.Column="1" Header="ID Document" PlaceholderText="Driver's License" Text="{x:Bind ViewModel.IdDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox x:Name="IdNumBox" Grid.Column="2" Header="ID Number" PlaceholderText="ID #" Text="{x:Bind ViewModel.IdNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
            
            <!-- DataGrid Card -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                <controls:DataGrid x:Name="WorksheetGrid" AutomationProperties.AutomationId="WorksheetGrid"
                                   AutoGenerateColumns="False" 
                                   ItemsSource="{x:Bind ViewModel.LineItems}"
                                   GridLinesVisibility="Horizontal"
                                   BorderThickness="0"
                                   Background="Transparent">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Header="Action" Width="120">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                            <controls:DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              ItemsSource="{Binding AllTransactionTypes}"
                                              HorizontalAlignment="Stretch" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellEditingTemplate>
                        </controls:DataGridTemplateColumn>
        
                        <controls:DataGridTemplateColumn Header="Description" Width="2*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        
                        <controls:DataGridTemplateColumn Header="Assay Method" Width="120">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AssayMethod}" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                            <controls:DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding AssayMethod, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                              ItemsSource="{Binding DataContext.ViewModel.AvailableAssayTools, ElementName=WorksheetGrid}"
                                              HorizontalAlignment="Stretch" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellEditingTemplate>
                        </controls:DataGridTemplateColumn>
                        
                        <controls:DataGridTemplateColumn Header="Qty" Width="60">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox AutomationProperties.AutomationId="QtyInput" Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        
                        <controls:DataGridTemplateColumn Header="Gross Wt (g)" Width="*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox AutomationProperties.AutomationId="WeightInput" Text="{Binding WeightInputText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        
                        <controls:DataGridTemplateColumn Header="Purity %" Width="*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox AutomationProperties.AutomationId="PurityInput" Text="{Binding PurityInputText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        
                        <controls:DataGridTextColumn Header="Fine Wt (g)" Binding="{Binding FineWeightGrams, Converter={StaticResource NumericConverter}}" Width="*" IsReadOnly="True"/>
                        <controls:DataGridTextColumn Header="Spot / g" Binding="{Binding LiveSpotPricePerGram, Converter={StaticResource NumericConverter}}" Width="*" IsReadOnly="True"/>
                        
                        <controls:DataGridTemplateColumn Header="Margin %" Width="*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DealerMarginValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NumericConverter}}" Background="Transparent" BorderThickness="0" Margin="4"/>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        
                        <controls:DataGridTextColumn Header="Final Price" Binding="{Binding FinalFiatPrice}" Width="*" IsReadOnly="True"/>
                        <controls:DataGridTemplateColumn Header="Delete" Width="80">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Click="DeleteRowBtn_Click" HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="Delete" Foreground="Red"/>
                                    </Button>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Photo" Width="80">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Click="CapturePhotoBtn_Click" HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="Camera" Foreground="Blue"/>
                                    </Button>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Border>
            
            <!-- Action Footer Card -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="AddRowBtn" AutomationProperties.AutomationId="AddRowBtn" Content="Add Custom Item" Command="{x:Bind ViewModel.AddRowCommand}"/>
                        <ComboBox x:Name="CatalogCombo" PlaceholderText="Select Catalog Item..." Width="200" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.CatalogItems, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCatalogItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button x:Name="AddCatalogItemBtn" Content="Add from Catalog" Command="{x:Bind ViewModel.AddCatalogItemCommand}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Grace Period:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="GracePeriodCombo" Width="120" SelectedIndex="0">
                                <ComboBoxItem Content="Instant"/>
                                <ComboBoxItem Content="24 Hours"/>
                                <ComboBoxItem Content="48 Hours"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
                            <TextBlock Text="Net Settlement:" VerticalAlignment="Center" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SettlementTotalText" Text="{x:Bind ViewModel.SettlementTotalText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="Blue" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button x:Name="LockQuoteBtn" AutomationProperties.AutomationId="LockQuoteBtn" Content="Lock &amp; Print Quote" Style="{StaticResource AccentButtonStyle}" Click="LockQuoteBtn_Click" IsEnabled="{x:Bind ViewModel.IsQuoteActive, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>
</Page>
